# Neon (direct host, not *-pooler*). From the console URI, add +psycopg after postgresql.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Local Docker fallback: make db-up
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
JWT_SECRET=change-me-to-a-32-byte-or-longer-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon Object Storage (path-style S3). Copy keys from the branch Connect / Credentials
# modal (storage:read + storage:write). Do not run `neon env pull` — it overwrites
# DATABASE_URL and JWT_SECRET. Python uses boto3, not the console's npm snippet.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-dry-haze-axd19uab.storage.c-4.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
DOCUMENTS_BUCKET=documents

# Worker / OpenRouter (API starts without these; extraction fails until set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_PDF_ENGINE=native
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=30
MAX_IMAGE_PIXELS=50000000
WORKER_POLL_SECONDS=2
